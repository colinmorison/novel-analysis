<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.colin</groupId>
        <artifactId>novel-analysis</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>novel-analysis-starter</artifactId>
    <name>novel-analysis-starter</name>
    <description>启动模块：Spring Boot Application 与配置</description>

    <dependencies>
        <dependency>
            <groupId>com.colin</groupId>
            <artifactId>novel-analysis-interfaces</artifactId>
        </dependency>
        <dependency>
            <groupId>com.colin</groupId>
            <artifactId>novel-analysis-infrastructure</artifactId>
        </dependency>
        <dependency>
            <groupId>com.colin</groupId>
            <artifactId>novel-analysis-application</artifactId>
        </dependency>
        <dependency>
            <groupId>com.colin</groupId>
            <artifactId>novel-analysis-domain</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
