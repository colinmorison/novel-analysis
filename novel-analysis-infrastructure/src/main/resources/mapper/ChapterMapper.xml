<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.colin.novelanalysis.infrastructure.persistence.mapper.ChapterMapper">

    <resultMap id="chapterMap" type="com.colin.novelanalysis.domain.model.Chapter">
        <id property="id" column="id"/>
        <result property="novelId" column="novel_id"/>
        <result property="chapterNo" column="chapter_no"/>
        <result property="title" column="title"/>
        <result property="startPos" column="start_pos"/>
        <result property="endPos" column="end_pos"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO novel_chapter (novel_id, chapter_no, title, start_pos, end_pos, created_at)
        VALUES (#{novelId}, #{chapterNo}, #{title}, #{startPos}, #{endPos}, #{createdAt})
    </insert>

    <select id="selectByNovelId" resultMap="chapterMap">
        SELECT * FROM novel_chapter WHERE novel_id = #{novelId} ORDER BY chapter_no
    </select>

</mapper>
