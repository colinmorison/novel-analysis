<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.colin.novelanalysis.infrastructure.persistence.mapper.NovelMapper">

    <resultMap id="novelMap" type="com.colin.novelanalysis.domain.model.Novel">
        <id property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="author" column="author"/>
        <result property="fileName" column="file_name"/>
        <result property="minioPath" column="minio_path"/>
        <result property="fileSize" column="file_size"/>
        <result property="parseStatus" column="parse_status"/>
        <result property="parseError" column="parse_error"/>
        <result property="uploadedAt" column="uploaded_at"/>
        <result property="parsedAt" column="parsed_at"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO novel (title, author, file_name, minio_path, file_size, parse_status, parse_error, uploaded_at, parsed_at)
        VALUES (#{title}, #{author}, #{fileName}, #{minioPath}, #{fileSize}, #{parseStatus}, #{parseError}, #{uploadedAt}, #{parsedAt})
    </insert>

    <select id="selectById" resultMap="novelMap">
        SELECT * FROM novel WHERE id = #{id}
    </select>

    <select id="selectAll" resultMap="novelMap">
        SELECT * FROM novel ORDER BY uploaded_at DESC
    </select>

    <update id="updateStatus">
        UPDATE novel
        SET parse_status = #{parseStatus},
            parse_error = #{parseError},
            parsed_at = #{parsedAt}
        WHERE id = #{id}
    </update>

</mapper>
